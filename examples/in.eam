# BCC Iron Crystal

units           metal
dimension       3
boundary        p p p
atom_style      atomic

# BCC Fe lattice
lattice         bcc 2.8665
region          box block 0 1 0 1 0 1
create_box      1 box
create_atoms    1 box

replicate       8 8 8 

mass            1 55.845

# EAM potential
pair_style      eam/fs
pair_coeff      * * Fe_mm.eam.fs Fe
timestep        0.001 

neighbor        2.0 bin
neigh_modify    delay 10

# Energy minimization
min_style       cg
minimize        1e-12 1e-12 1000 10000

# Initialize temperature
velocity        all create 300.0 12345 mom yes rot no

# equilibration
fix             1 all nve 
fix             2 all temp/berendsen 300 300 0.1 
fix             3 all press/berendsen iso 1 1 100 
# fix             1 all nvt temp 300 300 0.1
# fix             1 all npt temp 300 300 0.1 iso 1 1 1.0 

thermo          100
thermo_style    custom step temp press pe ke etotal lx density 

# dump            1 all custom 100 dump.fe id type x y z
dump            1 all xyz 1000 fe_ref.xyz

run             10000

